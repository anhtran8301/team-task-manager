APP_NAME="Team Task Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=team_tasks
DB_USERNAME=team_tasks
DB_PASSWORD=local-password
CACHE_STORE=file
SESSION_DRIVER=file
SANCTUM_EXPIRATION=120
SESSION_COOKIE=team_tasks_session
SESSION_SECURE_COOKIE=false
AUTH_COOKIE_SECURE=false

# Optional precomputed dummy hash; keep single quotes around bcrypt $ characters.
# Regenerate when HASH_DRIVER or BCRYPT_ROUNDS changes (see README).
# AUTH_DUMMY_PASSWORD_HASH='your-generated-hash'
