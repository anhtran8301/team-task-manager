{
    "name": "team-task-manager/api",
    "type": "project",
    "description": "Team Task Manager REST API",
    "license": "MIT",
    "require": {
        "php": "~8.3.0",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.0",
        "laravel/tinker": "^2.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "phpunit",
        "lint": "pint --test"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore": {
                    "laravel/framework": {
                        "constraint": "11.56.1",
                        "on-block": true,
                        "reason": "Assignment explicitly requires Laravel 11. Keep advisories visible in composer audit; local evaluation only.",
                        "on-audit": false
                    }
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
